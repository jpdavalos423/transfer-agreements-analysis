#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from tests.golden.runner import run_all  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Run golden scenario suites.")
    parser.add_argument(
        "--suite",
        choices=("phase_a", "full"),
        required=True,
        help="Golden suite selector.",
    )
    parser.add_argument(
        "--repeat",
        type=int,
        default=1,
        help="Run count for determinism checks.",
    )
    parser.add_argument(
        "--scenarios-dir",
        default=str(REPO_ROOT / "tests" / "golden" / "scenarios"),
    )
    parser.add_argument(
        "--expected-dir",
        default=str(REPO_ROOT / "tests" / "golden" / "expected"),
    )
    args = parser.parse_args()

    if args.repeat < 1:
        raise SystemExit("--repeat must be >= 1")

    baseline = run_all(args.scenarios_dir, args.expected_dir, suite=args.suite)
    for _ in range(args.repeat - 1):
        current = run_all(args.scenarios_dir, args.expected_dir, suite=args.suite)
        if current != baseline:
            raise AssertionError("Non-deterministic golden output across repeated runs.")

    print(
        f"Golden suite '{args.suite}' passed: "
        f"{len(baseline)} scenarios (repeat={args.repeat})."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
