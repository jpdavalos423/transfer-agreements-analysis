#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]


def _wait_json(url: str, timeout_seconds: float = 20.0) -> dict:
    deadline = time.time() + timeout_seconds
    last_error: Exception | None = None
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as resp:
                if resp.status != 200:
                    raise RuntimeError(f"{url} returned status {resp.status}")
                return json.loads(resp.read().decode("utf-8"))
        except Exception as exc:  # noqa: BLE001
            last_error = exc
            time.sleep(0.5)
    raise RuntimeError(f"Timed out waiting for {url}: {last_error}")


def _wait_text(url: str, timeout_seconds: float = 20.0) -> str:
    deadline = time.time() + timeout_seconds
    last_error: Exception | None = None
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as resp:
                if resp.status != 200:
                    raise RuntimeError(f"{url} returned status {resp.status}")
                return resp.read().decode("utf-8")
        except Exception as exc:  # noqa: BLE001
            last_error = exc
            time.sleep(0.5)
    raise RuntimeError(f"Timed out waiting for {url}: {last_error}")


def _terminate(proc: subprocess.Popen[str]) -> None:
    if proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=8)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait(timeout=3)


def _run_stdlib_backend_smoke() -> None:
    env_api = dict(os.environ)
    env_api["TPP_API_HOST"] = "127.0.0.1"
    env_api["TPP_API_PORT"] = "8000"

    api = subprocess.Popen([sys.executable, "-m", "apps.api.server"], cwd=str(REPO_ROOT), env=env_api)
    frontend_env = dict(os.environ)
    frontend_env["VITE_API_BASE_URL"] = "http://127.0.0.1:8000"
    frontend = subprocess.Popen(
        ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5174", "--strictPort"],
        cwd=str(REPO_ROOT / "apps" / "frontend"),
        env=frontend_env,
    )
    try:
        health = _wait_json("http://127.0.0.1:8000/v1/health")
        if health.get("version") != "v1":
            raise RuntimeError("stdlib health payload missing version=v1")
        html = _wait_text("http://127.0.0.1:5174/")
        if "Transfer Pathway Planner" not in html:
            raise RuntimeError("frontend root missing expected title text")
        print("[PASS] stdlib backend + frontend smoke")
    finally:
        _terminate(frontend)
        _terminate(api)


def _run_fastapi_backend_smoke() -> None:
    env = dict(os.environ)
    env.setdefault("TPP_FASTAPI_HOST", "127.0.0.1")
    env.setdefault("TPP_FASTAPI_PORT", "8100")

    backend = subprocess.Popen(
        ["uvicorn", "apps.backend.main:app", "--host", "127.0.0.1", "--port", "8100"],
        cwd=str(REPO_ROOT),
        env=env,
    )

    frontend_env = dict(os.environ)
    frontend_env["VITE_API_BASE_URL"] = "http://127.0.0.1:8100"
    frontend = subprocess.Popen(
        ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5174", "--strictPort"],
        cwd=str(REPO_ROOT / "apps" / "frontend"),
        env=frontend_env,
    )

    try:
        health = _wait_json("http://127.0.0.1:8100/v1/health")
        if health.get("version") != "v1":
            raise RuntimeError("fastapi health payload missing version=v1")
        html = _wait_text("http://127.0.0.1:5174/")
        if "Transfer Pathway Planner" not in html:
            raise RuntimeError("frontend root missing expected title text")
        print("[PASS] fastapi backend + frontend smoke")
    finally:
        _terminate(frontend)
        _terminate(backend)


def main() -> int:
    parser = argparse.ArgumentParser(description="Smoke-check frontend with backend startup modes.")
    parser.add_argument("--mode", choices=("stdlib", "fastapi", "both"), default="both")
    args = parser.parse_args()

    if args.mode in {"stdlib", "both"}:
        _run_stdlib_backend_smoke()
    if args.mode in {"fastapi", "both"}:
        _run_fastapi_backend_smoke()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
